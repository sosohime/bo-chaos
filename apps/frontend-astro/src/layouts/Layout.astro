---
import background from '../assets/background.svg';
import { sitePath, siteUrl } from '../lib/site-paths';

interface Props {
  title: string;
  description: string;
  siteName?: string;
  canonicalUrl?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  siteName = '博Fans',
  canonicalUrl,
  structuredData,
} = Astro.props;
const faviconPath = import.meta.env.DEV ? '/bo.ico' : sitePath('/bo.ico');
const sourceRoute = Astro.url.pathname.replace(/^\/retire(?=\/|$)/, '') || '/';
const canonicalRoute = sourceRoute.endsWith('/')
  ? sourceRoute
  : `${sourceRoute}/`;
const resolvedCanonicalUrl =
  canonicalUrl ?? siteUrl(canonicalRoute as `/${string}`);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZEB8YFKSCR"
    ></script>
    <script>
      import { onCLS, onINP, onLCP } from 'web-vitals';
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // @ts-ignore
        dataLayer.push(arguments);
      }
      // @ts-ignore
      gtag('js', new Date());
      // @ts-ignore
      gtag('config', 'G-ZEB8YFKSCR');

      function sendToGoogleAnalytics({ name, delta, value, id }: any) {
        // @ts-ignore
        gtag('event', name, {
          value: delta, // Use `delta` so the value can be summed.
          metric_id: id, // Needed to aggregate events.
          metric_value: value, // Optional.
          metric_delta: delta, // Optional.
        });
      }
      onCLS(sendToGoogleAnalytics);
      onINP(sendToGoogleAnalytics);
      onLCP(sendToGoogleAnalytics);
    </script>
    <script></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={faviconPath} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={resolvedCanonicalUrl} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <div id="background" style={`background-image: url(${background.src});`}>
    </div>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(100px);
  }
</style>
