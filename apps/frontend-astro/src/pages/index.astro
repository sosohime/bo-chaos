---
import { ArrowRight, ArrowUpRight, Rss } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/editorial/SiteShell.astro';
import NewsExplorer from '../components/editorial/NewsExplorer.astro';
import CommunityLinks from '../components/editorial/CommunityLinks.astro';
import RetirementClock from '../components/editorial/RetirementClock.astro';
import {
  contentUpdated,
  featuredRecord,
  productRecords,
  recordHref,
  sourceCount,
  newsRecords,
} from '../data/news';
import { SITE_ORIGIN, sitePath, siteUrl } from '../lib/site-paths';

const title = '博新闻｜腾讯云袁博的 Lighthouse 与云计算公开动态';
const description =
  '博Fans 从粉丝视角整理腾讯云袁博与 Lighthouse、企业上云和 AI 智能体有关的公开动态，所有职业信息均附原始出处。';
const canonicalUrl = `${SITE_ORIGIN}/`;
const profileUrl = siteUrl('/yuanbo/');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_ORIGIN}/#website`,
      url: canonicalUrl,
      name: '博新闻',
      alternateName: ['博Fans', 'BoFans'],
      inLanguage: 'zh-CN',
    },
    {
      '@type': 'Person',
      '@id': `${profileUrl}#person`,
      url: profileUrl,
      name: '袁博',
      alternateName: ['腾讯云袁博'],
      jobTitle: ['腾讯云 Lighthouse 产品经理', '腾讯云认证讲师'],
      worksFor: {
        '@type': 'Organization',
        name: '腾讯云',
        url: 'https://cloud.tencent.com/',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_ORIGIN}/#sources`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'zh-CN',
      dateModified: contentUpdated,
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      about: { '@id': `${profileUrl}#person` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: newsRecords.map((record, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: record.title,
          url: record.paragraphs ? siteUrl(`/news/${record.id}/`) : record.url,
        })),
      },
    },
  ],
};
---

<Layout
  {title}
  {description}
  {canonicalUrl}
  {structuredData}
  editorial
  siteName="博新闻"
  image={siteUrl('/editorial/lighthouse.webp')}
>
  <SiteShell active="news" updated={contentUpdated}>
    <section class="news-intro" aria-labelledby="page-title">
      <div>
        <p class="eyebrow">博Fans 独立维护</p><h1 id="page-title">
          博新闻<span class="edition-word" aria-hidden="true">THE BO POST</span>
        </h1><p class="intro-copy">
          记录袁博与 Lighthouse 的公开动态，<br
            class="desktop-break"
          />也关注云端发生的新鲜事。
        </p>
      </div>
      <a class="text-link subscribe" href={sitePath('/rss.xml')}
        ><Rss size={16} strokeWidth={1.6} aria-hidden="true" />RSS 订阅</a
      >
    </section>
    <div class="lead-grid">
      <article class="lead-story">
        <a
          href={recordHref(featuredRecord)}
          class="lead-image"
          aria-label={`阅读：${featuredRecord.title}`}
          ><img
            src={sitePath('/editorial/lighthouse.webp')}
            srcset={`${sitePath('/editorial/lighthouse-small.webp')} 800w, ${sitePath('/editorial/lighthouse.webp')} 1200w`}
            sizes="(max-width: 767px) calc(100vw - 36px), (max-width: 1230px) 60vw, 720px"
            width="1200"
            height="800"
            alt="蓝色灯塔立于海岛上的栏目概念插画"
            fetchpriority="high"
            decoding="async"
          /></a
        >
        <div class="lead-copy">
          <div class="article-meta">
            <span class="topic">公开分享</span><span
              >来源发布 <time datetime={featuredRecord.publishedAt}
                >{featuredRecord.publishedAt}</time
              ></span
            >
          </div><h2>
            <a href={recordHref(featuredRecord)}>{featuredRecord.title}</a>
          </h2><p>{featuredRecord.summary}</p><a
            class="text-link"
            href={recordHref(featuredRecord)}
            >阅读记录 <ArrowRight
              size={17}
              strokeWidth={1.6}
              aria-hidden="true"
            /></a
          >
        </div>
      </article>
      <aside class="lead-aside" aria-label="产品观察与退休倒计时">
        <section class="product-brief">
          <div class="brief-head">
            <h2>产品观察</h2><span class="meta">核对于 {contentUpdated}</span>
          </div><p class="brief-note">来自 Lighthouse 产品页</p><div
            class="brief-list"
          >
            {
              productRecords.slice(0, 3).map((record) => (
                <a href={record.url} target="_blank" rel="noopener noreferrer">
                  <>
                    <span class="meta topic">{record.sourceType}</span>
                    <h3>
                      {record.title}
                      <ArrowUpRight
                        size={16}
                        strokeWidth={1.6}
                        aria-hidden="true"
                      />
                    </h3>
                  </>
                </a>
              ))
            }
          </div><a class="text-link" href="#public-sources"
            >查看全部动态 <ArrowRight
              size={16}
              strokeWidth={1.6}
              aria-hidden="true"
            /></a
          >
        </section>
        <section class="retire-teaser">
          <div class="brief-head">
            <h2>博退休</h2><a href={sitePath('/bo/')} aria-label="查看博退休"
              ><ArrowUpRight size={19} strokeWidth={1.6} /></a
            >
          </div><p class="meta">距离约定的那一天</p><RetirementClock
            compact
          /><p class="meta">社区设定的倒计时，陪博哥一起期待。</p>
        </section>
      </aside>
    </div>
    <NewsExplorer />
    <section
      id="about"
      class="section about-section"
      aria-labelledby="about-title"
    >
      <div>
        <h2 id="about-title" class="section-title">关注博哥，也尊重事实。</h2><p
          class="section-intro"
        >
          博新闻是 yuanbo.online
          的粉丝栏目，不是袁博个人网站，也不代表腾讯云官方立场。
        </p><p class="section-intro">
          页面保留来源之间的差异，不把粉丝评价写成职业事实。产品动态按公开页面整理，不据此推断袁博个人参与了每项产品工作。
        </p><div class="link-row about-links">
          <a class="text-link" href={sitePath('/yuanbo/')}
            >查看袁博公开资料 <ArrowRight
              size={16}
              strokeWidth={1.6}
              aria-hidden="true"
            /></a
          >
        </div>
      </div>
      <div class="source-standard">
        <p class="source-number mono">
          {sourceCount}<span>个公开来源链接</span>
        </p><p>
          每条记录附出处<br />发布日期与核对日期分开标注<br
          />插画为栏目概念图，非新闻现场
        </p>
      </div>
    </section>
    <CommunityLinks />
  </SiteShell>
</Layout>
<style>
  .news-intro {
    padding: 42px 0 32px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  h1 {
    display: flex;
    align-items: baseline;
    gap: 22px;
    font-size: clamp(42px, 5vw, 60px);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.07em;
    margin: 12px 0 15px;
  }
  .edition-word {
    font-size: 11px;
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: 0.07em;
    color: var(--muted);
  }
  .intro-copy {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.85;
  }
  .desktop-break {
    display: none;
  }
  .subscribe {
    margin-bottom: 4px;
  }
  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(280px, 1fr);
    gap: 32px;
    margin-bottom: 48px;
  }
  .lead-story {
    min-width: 0;
    display: block;
  }
  .lead-image {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    background: var(--soft);
  }
  .lead-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.65;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s;
  }
  .lead-image:hover img {
    transform: scale(1.02);
  }
  .lead-copy {
    padding-top: 22px;
  }
  .lead-copy h2 {
    font-size: clamp(22px, 2.3vw, 30px);
    line-height: 1.4;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin-top: 12px;
  }
  .lead-copy p {
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    margin: 12px 0 18px;
    max-width: 62ch;
  }
  .lead-aside {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .brief-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .brief-head h2 {
    font-size: 17px;
    font-weight: 700;
  }
  .brief-head .meta {
    font-size: 10px;
  }
  .brief-note {
    font-size: 11px;
    color: var(--muted);
    margin-top: 6px;
  }
  .product-brief {
    border-top: 2px solid var(--accent);
    padding-top: 18px;
  }
  .brief-list {
    margin: 12px 0 16px;
  }
  .brief-list a {
    display: block;
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
  }
  .brief-list h3 {
    display: flex;
    align-items: start;
    gap: 12px;
    justify-content: space-between;
    font-size: 14px;
    line-height: 1.6;
    font-weight: 600;
    margin-top: 5px;
  }
  .brief-list h3 :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .retire-teaser {
    margin-top: auto;
    padding: 20px 22px;
    background: var(--soft);
    border-radius: 12px;
  }
  .retire-teaser > .meta {
    margin-top: 8px;
    font-size: 11px;
  }
  .about-section {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(220px, 1fr);
    gap: 64px;
  }
  .about-links {
    margin-top: 22px;
  }
  .source-standard {
    align-self: center;
    border-left: 1px solid var(--line);
    padding-left: 40px;
  }
  .source-number {
    font-size: 58px;
    line-height: 1;
    color: var(--accent);
  }
  .source-number span {
    display: block;
    margin-top: 12px;
    font-size: 12px;
    font-family: var(--font);
    color: var(--ink);
  }
  .source-standard > p:last-child {
    margin-top: 22px;
    font-size: 12px;
    color: var(--muted);
    line-height: 2;
  }
  @media (max-width: 1023px) {
    .lead-grid {
      gap: 24px;
      grid-template-columns: minmax(0, 1.35fr) minmax(260px, 1fr);
    }
    .lead-image img {
      height: auto;
    }
    .lead-copy h2 {
      font-size: 24px;
    }
    .brief-list h3 {
      font-size: 13px;
    }
  }
  @media (max-width: 767px) {
    .news-intro {
      padding: 30px 0 24px;
      align-items: start;
      gap: 8px;
    }
    h1 {
      display: block;
      font-size: 42px;
      margin-top: 10px;
    }
    .edition-word {
      display: none;
    }
    .intro-copy {
      font-size: 13px;
    }
    .desktop-break {
      display: initial;
    }
    .subscribe {
      font-size: 11px;
      margin-top: 5px;
    }
    .lead-grid {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: 32px;
    }
    .lead-image img {
      height: auto;
      aspect-ratio: 1.65;
    }
    .lead-copy h2 {
      font-size: 24px;
    }
    .lead-aside {
      gap: 24px;
    }
    .brief-list h3 {
      font-size: 15px;
    }
    .retire-teaser {
      padding: 22px;
    }
    .about-section {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .source-standard {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding: 24px 0 0;
      display: flex;
      gap: 30px;
    }
    .source-number {
      font-size: 46px;
    }
    .source-standard > p:last-child {
      margin-top: 0;
    }
  }
</style>
