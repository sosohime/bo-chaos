---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/editorial/SiteShell.astro';
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import { editorialRecords, recordHref } from '../data/news';
import { SITE_ORIGIN, sitePath, siteUrl } from '../lib/site-paths';

const title = '袁博｜腾讯云 Lighthouse 产品经理与云计算公开资料';
const description =
  '袁博公开资料页：整理腾讯云官方页面与公开报道中有关袁博、Lighthouse、企业上云和 AI 智能体的职业信息，并附原始来源。';
const canonicalUrl = siteUrl('/yuanbo/');
const personId = `${canonicalUrl}#person`;
const contentUpdated = '2026-08-18';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_ORIGIN}/#website`,
      url: `${SITE_ORIGIN}/`,
      name: '博新闻',
      alternateName: ['博Fans', 'BoFans'],
      inLanguage: 'zh-CN',
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'zh-CN',
      dateModified: contentUpdated,
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      mainEntity: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      url: canonicalUrl,
      name: '袁博',
      alternateName: ['腾讯云袁博'],
      jobTitle: ['腾讯云 Lighthouse 产品经理', '腾讯云认证讲师'],
      worksFor: {
        '@type': 'Organization',
        name: '腾讯云',
        url: 'https://cloud.tencent.com/',
      },
      knowsAbout: [
        '腾讯云 Lighthouse',
        '云计算',
        '企业上云',
        '云上 IT 资产管理',
        'AI 智能体',
        'OPC',
      ],
      sameAs: [
        'https://cloud.tencent.cn/developer/learning',
        'https://cloud.tencent.com/developer/salon/speakers?initial=Y&page=1',
      ],
      subjectOf: [
        {
          '@type': 'DigitalDocument',
          headline: 'Lighthouse 赋能跨境电商 AI 新增长',
          url: 'https://www.fxbaogao.com/detail/5518348',
          datePublished: '2026-07-07',
        },
        {
          '@type': 'Article',
          headline: '腾讯云企业信息化系统上云与安全管理重构实践',
          url: 'https://cloud.tencent.com/developer/article/2679014',
          datePublished: '2026-05-31',
        },
        {
          '@type': 'NewsArticle',
          headline: '百“虾”混战升级，百度押注超级个体，OPC生态卡位战火正酣',
          url: 'https://wap.eastmoney.com/a/202605163739376785.html',
          datePublished: '2026-05-16',
        },
      ],
    },
  ],
};
---

<Layout
  {title}
  {description}
  siteName="博新闻"
  {canonicalUrl}
  {structuredData}
  editorial
  image={siteUrl('/editorial/lighthouse.webp')}
>
  <SiteShell active="profile" updated={contentUpdated}>
    <section id="profile" class="profile-intro" aria-labelledby="page-title">
      <div class="reading-head">
        <p class="eyebrow">公开人物资料</p><h1 id="page-title">袁博</h1><p
          class="lead"
        >
          腾讯云 Lighthouse 产品经理、腾讯云认证讲师。
        </p><p class="profile-summary">
          公开资料显示，他长期从事云计算产品服务与策划，并参与企业上云与 AI
          智能体相关实践。
        </p><p class="profile-disclaimer">
          本页由博Fans依据公开来源独立整理，不是袁博个人主页，也不代表腾讯云官方立场。
        </p>
      </div>
      <figure>
        <img
          src={sitePath('/editorial/lighthouse.webp')}
          srcset={`${sitePath('/editorial/lighthouse-small.webp')} 800w, ${sitePath('/editorial/lighthouse.webp')} 1200w`}
          sizes="(max-width: 767px) 1px, 420px"
          loading="lazy"
          width="1200"
          height="800"
          alt="蓝色灯塔主题插画，代表 Lighthouse 栏目"
          decoding="async"
        /><figcaption>关注 Lighthouse 与云计算公开实践</figcaption>
      </figure>
    </section>
    <section id="sources" class="section" aria-labelledby="facts-title">
      <h2 id="facts-title" class="section-title">公开职业资料</h2><p
        class="section-intro"
      >
        以下信息仅保留原始页面能够支持的表述。来源之间存在差异时，以各自公开页面为准。
      </p>
      <div class="profile-records">
        {
          editorialRecords.map((record) => (
            <article>
              <>
                <div>
                  <>
                    <span class="meta topic">{record.category}</span>
                    <h3>{record.title}</h3>
                    <span class="meta">{record.source}</span>
                  </>
                </div>
                <div>
                  <>
                    <p>{record.paragraphs?.[0]}</p>
                    <div class="link-row">
                      <>
                        <a class="text-link" href={recordHref(record)}>
                          阅读记录{' '}
                          <ArrowRight
                            size={16}
                            strokeWidth={1.6}
                            aria-hidden="true"
                          />
                        </a>
                        <a
                          class="text-link"
                          href={record.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          查看来源{' '}
                          <ArrowUpRight
                            size={16}
                            strokeWidth={1.6}
                            aria-hidden="true"
                          />
                        </a>
                      </>
                    </div>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="section">
      <h2 class="section-title">相关内容</h2><p class="section-intro">
        博新闻持续整理袁博与 Lighthouse、企业上云和 AI 智能体的公开动态。
      </p><div class="link-row related-links">
        <a class="text-link" href="/"
          >博新闻 <ArrowRight
            size={16}
            strokeWidth={1.6}
            aria-hidden="true"
          /></a
        ><a class="text-link" href={sitePath('/bo/')}
          >博退休 <ArrowRight
            size={16}
            strokeWidth={1.6}
            aria-hidden="true"
          /></a
        >
      </div>
    </section>
  </SiteShell>
</Layout>
<style>
  .profile-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    align-items: center;
    gap: 72px;
  }
  .reading-head h1 {
    font-size: 64px;
    letter-spacing: -0.05em;
    margin: 18px 0;
  }
  .profile-summary {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.85;
    margin-top: 18px;
  }
  .profile-disclaimer {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
    margin-top: 22px;
    padding-left: 16px;
    border-left: 2px solid var(--accent);
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.1;
    object-fit: cover;
    border-radius: 12px;
  }
  figcaption {
    margin-top: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  .profile-records {
    margin-top: 28px;
  }
  .profile-records article {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 48px;
    border-bottom: 1px solid var(--line);
    padding: 28px 0;
  }
  .profile-records article:last-child {
    border-bottom: 0;
  }
  h3 {
    font-size: 18px;
    font-weight: 650;
    line-height: 1.6;
    margin: 10px 0 12px;
  }
  .profile-records p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.9;
    margin-bottom: 20px;
  }
  .related-links {
    margin-top: 24px;
  }
  @media (max-width: 767px) {
    .profile-intro {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: 28px;
    }
    .reading-head h1 {
      font-size: 48px;
    }
    figure {
      display: none;
    }
    .profile-records article {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .profile-records p {
      font-size: 14px;
    }
  }
</style>
