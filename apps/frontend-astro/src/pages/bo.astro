---
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/editorial/SiteShell.astro';
import RetirementClock from '../components/editorial/RetirementClock.astro';
import CommunityLinks from '../components/editorial/CommunityLinks.astro';
import { productRecords, contentUpdated } from '../data/news';
import { SITE_ORIGIN, sitePath, siteUrl } from '../lib/site-paths';

const title = '袁博退休倒计时｜腾讯云博哥与博Fans';
const description =
  '腾讯云博哥袁博退休倒计时。陪博Fans一起记录时间、阅读 Lighthouse 公开动态，发现小游戏、桌宠和朋友们的作品。';
const canonicalUrl = siteUrl('/bo/');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_ORIGIN}/#website`,
      url: `${SITE_ORIGIN}/`,
      name: '博新闻',
      alternateName: ['博Fans', 'BoFans'],
      inLanguage: 'zh-CN',
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl('/yuanbo/')}#person`,
      url: siteUrl('/yuanbo/'),
      name: '袁博',
      alternateName: ['腾讯云袁博'],
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'zh-CN',
      dateModified: contentUpdated,
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      about: { '@id': `${siteUrl('/yuanbo/')}#person` },
    },
  ],
};
---

<Layout
  {title}
  {description}
  {canonicalUrl}
  {structuredData}
  editorial
  siteName="博退休"
  image={siteUrl('/editorial/retirement.webp')}
>
  <SiteShell active="retire" updated={contentUpdated}>
    <section
      class="retirement-panel"
      data-retirement-panel
      aria-labelledby="bo-countdown-title"
    >
      <div class="retirement-content">
        <p class="eyebrow">博退休</p>
        <h1 id="bo-countdown-title">袁博退休倒计时</h1>
        <p class="retirement-subtitle">好日子，正在一天天靠近。</p>
        <RetirementClock />
      </div>
      <figure class="retirement-visual">
        <img
          src={sitePath('/editorial/retirement.webp')}
          srcset={`${sitePath('/editorial/retirement-small.webp')} 800w, ${sitePath('/editorial/retirement.webp')} 1200w`}
          sizes="(max-width: 767px) calc(100vw - 36px), (max-width: 1230px) 40vw, 480px"
          width="1200"
          height="800"
          alt="面朝海边的蓝色躺椅与遮阳伞，关于闲暇时光的概念插画"
          fetchpriority="high"
          decoding="async"
        /><figcaption>
          <span>给未来，留一把椅子。</span><span>栏目概念插画</span>
        </figcaption>
      </figure>
    </section>
    <section class="section retire-news" aria-labelledby="bo-lighthouse-news">
      <h2 id="bo-lighthouse-news" class="section-title">
        等退休的时候，看看新动态。
      </h2>
      <p class="section-intro">
        Lighthouse 产品页的公开记录，资料核对于 <time datetime={contentUpdated}
          >{contentUpdated}</time
        >。
      </p>
      <div class="retire-news-list">
        {
          productRecords.map((record) => (
            <a href={record.url} target="_blank" rel="noopener noreferrer">
              <>
                <span class="meta topic">{record.sourceType}</span>
                <h3>{record.title}</h3>
                <ArrowUpRight size={19} strokeWidth={1.6} aria-hidden="true" />
              </>
            </a>
          ))
        }
      </div>
      <a class="text-link" href="/#public-sources"
        >查看全部动态 <ArrowRight
          size={17}
          strokeWidth={1.6}
          aria-hidden="true"
        /></a
      >
    </section>
    <CommunityLinks />
  </SiteShell>
</Layout>
<style>
  .retirement-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 60px;
    padding-block: 48px;
  }
  .retirement-content {
    min-width: 0;
    padding-top: 8px;
  }
  h1 {
    font-size: clamp(28px, 3.1vw, 40px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.045em;
    margin-top: 12px;
  }
  .retirement-subtitle {
    font-size: 16px;
    line-height: 1.8;
    color: var(--muted);
    margin: 14px 0 36px;
  }
  .retirement-visual {
    align-self: stretch;
    min-width: 0;
    position: relative;
  }
  .retirement-visual img {
    display: block;
    width: 100%;
    height: calc(100% - 48px);
    min-height: 460px;
    object-fit: cover;
    object-position: 48% 50%;
    border-radius: 12px;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 16px;
    font-size: 11px;
    color: var(--muted);
  }
  figcaption span:last-child {
    font-size: 10px;
  }
  .retire-news-list {
    margin: 28px 0 24px;
    display: grid;
    gap: 0;
  }
  .retire-news-list a {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) 24px;
    align-items: baseline;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .retire-news-list h3 {
    font-size: 16px;
    font-weight: 550;
    line-height: 1.65;
  }
  .retirement-panel.is-focused {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    grid-template-columns: 1fr;
    background: var(--paper);
    padding: 32px;
    overflow: auto;
  }
  .is-focused .retirement-content {
    width: min(640px, 100%);
  }
  .is-focused .retirement-visual {
    display: none;
  }
  @media (max-width: 1023px) {
    .retirement-panel {
      gap: 32px;
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
    .retirement-visual img {
      object-position: 53% 50%;
    }
  }
  @media (max-width: 767px) {
    .retirement-panel {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-block: 30px;
    }
    h1 {
      font-size: 29px;
    }
    .retirement-subtitle {
      font-size: 14px;
      margin-bottom: 30px;
    }
    .retirement-visual img {
      height: auto;
      min-height: 0;
      aspect-ratio: 1.65;
    }
    .retire-news-list a {
      grid-template-columns: minmax(0, 1fr) 20px;
      gap: 10px;
    }
    .retire-news-list .meta {
      grid-column: 1/-1;
    }
    .retire-news-list h3 {
      font-size: 14px;
    }
    .retirement-panel.is-focused {
      padding: 24px 20px;
    }
  }
</style>
